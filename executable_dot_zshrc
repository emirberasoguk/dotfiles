autoload -Uz add-zsh-hook
play_error_sound() {
    local last_status=$?
    if [[ "$ERROR_SOUND_ENABLED" == "true" ]]; then
        if [[ $last_status -ne 0 && $last_status -ne 130 && $last_status -ne 148 ]]; then
            if [[ -f ~/.config/error_sound.mp3 ]]; then
                (mpv --no-video ~/.config/error_sound.mp3 &> /dev/null &)
            elif [[ -f ~/.config/error_sound.wav ]]; then
                (mpv --no-video ~/.config/error_sound.wav &> /dev/null &)
            else
                (spd-say -w -t female1 "fuuuhhh" &> /dev/null &)
            fi
        fi
    fi
}
add-zsh-hook precmd play_error_sound


